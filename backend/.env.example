# DevTwin Backend Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is in .gitignore.

# ── AI Configuration ──────────────────────────────────────────────────────────
# Optional: Google Gemini API key for live AI analysis (FREE tier, no credit card)
# Get your free key at: https://aistudio.google.com/app/apikey
# If not set, DevTwin runs in DEMO MODE with pre-computed realistic results.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
